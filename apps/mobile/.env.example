# URL du serveur admin Next.js joint par l'application mobile.
# Copier ce fichier en .env et adapter la valeur (jamais de secret ici :
# les variables EXPO_PUBLIC_* sont embarquées en clair dans l'application).
#  - développement : http autorisé (ex. machine locale ou IP du poste sur le Wi-Fi)
#  - build de production : https obligatoire, défini dans eas.json
EXPO_PUBLIC_API_URL=http://localhost:3000
