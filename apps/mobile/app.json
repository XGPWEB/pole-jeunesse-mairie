{
  "expo": {
    "name": "Pôle Jeunesse Nogent",
    "slug": "pole-jeunesse-nogent",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B3A6B"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "fr.nogentsurmarne.polejeunesse"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#1B3A6B"
      },
      "package": "fr.nogentsurmarne.polejeunesse"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "polejeunesse",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "335ebad1-1358-4f6d-bb5e-a145bfeb13fb"
      }
    },
    "owner": "pressweb"
  }
}
