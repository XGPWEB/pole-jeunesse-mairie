{
  "name": "@pole-jeunesse/admin",
  "version": "2.13.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3001",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration:setup": "bash scripts/setup-test-db.sh",
