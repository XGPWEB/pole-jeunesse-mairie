# ─────────────────────────────────────────────────────────────────────────────
#  Pôle Jeunesse — Variables d'accès SSH au VPS de production
#
#  Copier ce fichier en `deploy.env` (à la racine du repo, non versionné —
#  voir .gitignore) et renseigner les vraies valeurs :
#
#    cp deploy.env.example deploy.env
#
#  `deploy.env` est chargé automatiquement par deploy.sh et les scripts de scripts/
#  s'il existe. En son absence, ces scripts retombent sur les valeurs codées
#  en dur historiques (pour ne pas casser un déploiement existant qui n'a pas
#  encore créé ce fichier), mais il est recommandé de créer `deploy.env` pour
#  ne plus dépendre de secrets en dur dans les scripts versionnés.
# ─────────────────────────────────────────────────────────────────────────────

VPS_IP=xxx.xxx.xxx.xxx
VPS_USER=root
SSH_KEY=$HOME/.ssh/id_rsa_exemple
